      "title": "Connected Edge Hosts",
      "type": "table",
      "datasource": "PostgreSQL",
      "targets": [
        {
          "format": "table",
          "rawSql": "SELECT agent_id, hostname, ip_address, os_type, agent_version, last_seen_at, status FROM agents ORDER BY last_seen_at DESC LIMIT 20;",
          "refId": "A"
        }
      ]
    },
    {
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 23 },
      "id": 10,
      "title": "Unresolved Incident Alerts",
      "type": "table",
      "datasource": "PostgreSQL",
      "targets": [
        {
          "format": "table",
          "rawSql": "SELECT id, agent_id, alert_type, severity, message, metric_value, threshold_value, created_at FROM alerts WHERE resolved_at IS NULL ORDER BY created_at DESC LIMIT 20;",
          "refId": "A"
        }
      ]
    }
